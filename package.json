{
  "name": "bidindex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "migrate:down": "tsx --env-file=.env.local scripts/migrate-down.ts",
    "backup": "tsx --env-file=.env.local scripts/backup-json.ts",
    "seed:demo": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "test": "node --import tsx --test lib/__tests__/*.test.ts",
    "reset": "tsx --env-file=.env.local scripts/reset-board.ts",
    "votes:set": "tsx --env-file=.env.local scripts/set-product-upvotes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@vemetric/node": "^0.2.0",
    "@vemetric/react": "^0.6.1",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
