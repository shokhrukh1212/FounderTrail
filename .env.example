# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin used to generate badge, verification, API, and share URLs.
# Production example: https://your-domain.example (no trailing slash).
SITE_URL=http://localhost:3000
SITE_NAME=BidIndex
SITE_DESCRIPTION=Discover pay-to-rank products, ad auctions and attention marketplaces. Explore new launches, compare real traction and submit your product for free.
SITE_ACCENT_COLOR=#FF6154
FEATURE_PROMOTIONS=false

# ---------------------------------------------------------------------------
# Database (auto-populated by the Neon Marketplace integration)
#   vercel integration add neon && vercel env pull
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Unpaid bid intents expire after this many minutes. Checkout does not hold a rank.
# ---------------------------------------------------------------------------
RESERVATION_MINUTES=10

# ---------------------------------------------------------------------------
# Cron. Any HTTP pinger (cron-job.org, QStash, Vercel cron) may call:
#   GET /api/cron/tick   with   Authorization: Bearer $CRON_SECRET
#
# QStash should call it every five minutes; Vercel Hobby remains a daily fallback.
# See docs/founder-email-operations.md for the exact schedule and header.
# ---------------------------------------------------------------------------
CRON_SECRET=

# Salt for hashing visitor IPs before storing them for click dedupe.
IP_HASH_SALT=
# Separate salt for BidIndex votes, partner visitors, redirects, and rate limits.
EVENT_HASH_SALT=

# Admin moderation login. Generate a long random value for production.
ADMIN_ACCESS_SECRET=
# Stable label written to campaign audit records.
ADMIN_AUDIT_ACTOR=Shokhrukh Karimov
# Optional. Milestones always appear in admin; this also receives an email alert.
ADMIN_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Transactional approval email — Resend (server-only)
# Verify the sending domain in Resend before production use. Keep click/open
# tracking disabled because management links contain a private URL fragment.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=BidIndex <notifications@bidindex.dev>
# Optional. Set only to a real monitored inbox.
EMAIL_REPLY_TO=

# Dedicated disposable PostgreSQL database used by migration/concurrency tests.
TEST_DATABASE_URL=

# Local development media. Local storage is refused in production.
UPLOAD_STORAGE_DRIVER=local
UPLOAD_LOCAL_DIR=.data/uploads

# Development/test only. Never enable private partner origins in production.
ALLOW_LOCAL_PARTNER_ORIGINS=false

# S3-compatible production media storage (not required for local development).
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Payments — Lemon Squeezy (Merchant of Record).
# ONE product/variant. It must accept custom prices from $1. The amount is passed as custom_price, and Lemon
# Squeezy collects the buyer's email and sends the receipt -- we never ask for it.
# Leave blank locally to use the dev checkout stub at /api/dev/complete.
# ---------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Analytics — Vemetric
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VEMETRIC_TOKEN=
# Private read key (project settings -> API tab). Powers the admin all-time visitor
# stat via the analytics query API. Server-only -- never prefix with NEXT_PUBLIC_.
VEMETRIC_API_KEY=
VEMETRIC_TOKEN=
# Opened by the all-time visitor stat in the admin subnav.
# Defaults to https://app.vemetric.com/public/bidindex.dev when blank.
VEMETRIC_PUBLIC_DASHBOARD_URL=

# ---------------------------------------------------------------------------
# Meta (Facebook) Pixel. The id is public -- it ships in the browser tag.
# Leave blank to omit the tag entirely.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# X (Twitter) Ads pixel. The id is public (ships in the browser tag); the access
# token is a secret used server-side for the Conversions API and must never be
# prefixed NEXT_PUBLIC_. Leave blank to skip both.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_X_PIXEL_ID=
X_PIXEL_ACCESS_TOKEN=
X_PIXEL_PURCHASE_EVENT_ID=
